{
  "name": "dsh-read-aloud",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: read conversation results aloud with the built-in Windows text-to-speech (no API keys, fully offline).",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "tts", "text-to-speech", "windows", "accessibility"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "paypal-qr.png", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
